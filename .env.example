# Copy this file to .env.local for local development and fill in real values.
# See docs/SUPABASE_SETUP.md for where to find each value and which ones go in Vercel.

# Supabase project URL (Project Settings -> Data API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable/anon key (Project Settings -> API Keys) -- safe to expose to the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role key (Project Settings -> API Keys) -- SERVER ONLY, never prefix with NEXT_PUBLIC_,
# never commit a real value, never import it from client-side code
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this app (used for auth redirects), e.g. http://localhost:3000 in dev
NEXT_PUBLIC_APP_URL=

# Plotabl Workforce module (see docs/PLOTABL_WORKFORCE_BUILD_TRACKER.md). Build-wide kill switch --
# /workforce 404s unless this is exactly "true", independent of any org's wf_module_settings row.
# Leave unset/false on the Q4K production deployment until the module is ready to ship.
NEXT_PUBLIC_ENABLE_WORKFORCE_MODULE=
