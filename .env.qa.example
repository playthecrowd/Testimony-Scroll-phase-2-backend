# Copy this file to .env.qa.local (already gitignored -- never commit the real file) and fill in
# real values. Used only by scripts/qaSeed.ts. Keep this file entirely separate from .env.local:
# qaSeed.ts must never be able to mistake an ordinary developer's local Supabase project for the
# approved deployed-QA project.
#
# Never paste real values for any of these into chat, a commit, a PR description, Trello, or a
# screenshot. This file must only ever contain variable names.

# --- Target project (must be the deployed QA project -- confirm this yourself in the Supabase
# and Vercel dashboards before filling these in; see docs/SUPABASE_SETUP.md) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Safety guards (all required; the script fails closed if any is missing or wrong) ---
# The project ref segment of NEXT_PUBLIC_SUPABASE_URL (https://<ref>.supabase.co). The script
# refuses to run if this doesn't match the URL above -- copy/paste errors fail loudly instead of
# silently targeting the wrong project.
QA_SUPABASE_PROJECT_REF=
# Must be exactly: deployed-qa
QA_ENVIRONMENT=
# Must be exactly: true -- required only for --execute, not --dry-run
ALLOW_QA_SEED=
# Domain used for all five synthetic QA emails, e.g. qa.quest4thekingdom.com
QA_EMAIL_DOMAIN=

# --- Five unique temporary passwords, one per QA identity ---
# Never printed, logged, committed, or pasted anywhere by qaSeed.ts. Store these yourself in your
# own password manager after running --execute once -- the script will not show them back to you.
QA_CHURCH_A_HOST_PASSWORD=
QA_CHURCH_A_MEMBER_PASSWORD=
QA_CHURCH_B_HOST_PASSWORD=
QA_CHURCH_B_MEMBER_PASSWORD=
QA_PLATFORM_ADMIN_PASSWORD=

# --- Optional ---
# Set to true to print each identity's profile id in the summary (not secret, off by default).
QA_PRINT_IDS=
